# Every variable here is OPTIONAL. With none of them set the app builds, boots,
# and serves — it just fetches everything from nostr relays on demand.

# ---------------------------------------------------------------------------
# Redis (optional cache + NIP-05 registry)
# ---------------------------------------------------------------------------
# Unset: no connection is ever opened. Profiles, articles and relay lists are
#        fetched live from relays, and the NIP-05 member registry falls back to
#        the static list in app/members.ts.
# Set:   Redis is used as a read-through cache and as the writable registry
#        that `pnpm sync` and `pnpm add-npub` populate.
# REDIS_URL=redis://localhost:6379

# How long to wait for Redis before giving up on a command, in ms.
# REDIS_CONNECT_TIMEOUT=1000
# REDIS_COMMAND_TIMEOUT=1000

# ---------------------------------------------------------------------------
# Timeouts
# ---------------------------------------------------------------------------
# Hard deadline for a server loader, in ms. Past it the route renders its
# skeleton and the browser finishes the fetch (see app/lib/ssr.ts).
# SSR_TIMEOUT=3000

# Same, for list-shaped loaders (home page members, sitemap).
# SSR_LIST_TIMEOUT=4000

# Deadline for a single relay request made during SSR, in ms. Keep it below
# SSR_TIMEOUT so a slow relay resolves as "no data" instead of blowing the
# whole loader budget.
# NOSTR_TIMEOUT=2500

# Deadline for a relay request made in the browser, in ms.
# VITE_CLIENT_TIMEOUT=10000

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# PORT=3000
